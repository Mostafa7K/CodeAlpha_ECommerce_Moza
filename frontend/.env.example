# Backend API base URL.
#
# This is a static (no build-tool) frontend, so this value is not consumed
# automatically by a bundler. It documents the URL that should be set as
# PRODUCTION_API_BASE_URL in js/config.js (or window.__MOZA_API_BASE_URL__)
# when deploying to Vercel.
#
# If this project is migrated to a build tool in the future, use the
# matching prefix for that tool, e.g.:
#   Vite:        VITE_API_BASE_URL
#   Next.js:     NEXT_PUBLIC_API_BASE_URL
#   Create React App: REACT_APP_API_BASE_URL
API_BASE_URL=https://codealpha-ecommerce-moza.onrender.com/api
