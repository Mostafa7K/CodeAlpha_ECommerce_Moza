# Server
PORT=5000
NODE_ENV=development

# Frontend origin allowed for CORS (with credentials)
CLIENT_ORIGIN=http://localhost:5500

# Deployed frontend URL (Render/production) - takes precedence over CLIENT_ORIGIN
FRONTEND_URL=

# MySQL Database (local MySQL or TiDB Cloud Serverless)
# For TiDB Cloud Serverless: leave DB_PORT unset to default to 4000 and set DB_SSL=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=moza_db
DB_SSL=false

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Cookie
COOKIE_NAME=moza_token

# Cloudinary (image upload & optimization)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin dashboard access (comma-separated emails)
ADMIN_EMAILS=most.kanaan7@gmail.com,zeinabajrouche123@gmail.com
