# Server
PORT=5000
NODE_ENV=development

# Frontend origin allowed for CORS (with credentials)
CLIENT_ORIGIN=http://localhost:5500

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=moza_db

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Cookie
COOKIE_NAME=moza_token
